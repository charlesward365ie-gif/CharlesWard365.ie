<style>
:root{
  --bg:#F3FAFE;--fg:#0B0B10;--muted:#44525E;--card:#FFFFFF;--line:#C5E4F4;
  --indigo:#0B0B10;--sun:#1EA3DE;--sky:#FFFFFF;--onsun:#0B0B10;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#07080C;--fg:#F2F8FC;--muted:#9FB2C0;--card:#10151C;--line:#1F2D3A}}
:root[data-theme="dark"]{--bg:#07080C;--fg:#F2F8FC;--muted:#9FB2C0;--card:#10151C;--line:#1F2D3A}
html{scroll-behavior:smooth;scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:"Newsreader",Georgia,serif;font-size:1.15rem;line-height:1.65}
h1,h2,h3{font-family:"Bricolage Grotesque","Helvetica Neue",Arial,sans-serif;line-height:1.05;margin:0;letter-spacing:-.02em}
a{color:inherit}
:focus-visible{outline:3px solid var(--sun);outline-offset:3px;border-radius:4px}
.wrap{max-width:1040px;margin:0 auto;padding:0 1.25rem}
nav{position:absolute;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:5}
nav .wrap{display:flex;justify-content:space-between;align-items:center;padding-top:1.1rem;padding-bottom:1.1rem;color:#0B0B10}
nav .logo{font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:800;font-size:1.3rem;text-decoration:none}
nav ul{display:flex;gap:1.4rem;list-style:none;margin:0;padding:0;font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:600;font-size:.95rem}
nav ul a{text-decoration:none;opacity:.9}nav ul a:hover{opacity:1;text-decoration:underline}
@media(max-width:620px){nav ul li:not(:last-child){display:none}}

.hero{position:relative;overflow:hidden;background:#1EA3DE;color:#0B0B10;padding:7rem 0 0;min-height:92vh;display:flex;align-items:flex-end}
.sun{position:absolute;left:74%;bottom:-300px;width:min(720px,140vw);aspect-ratio:1;border-radius:50%;transform:translateX(-50%) translateY(60%);background:radial-gradient(circle,#fff 0%,rgba(255,255,255,.55) 58%,rgba(255,255,255,0) 72%);animation:rise 2.6s cubic-bezier(.2,.7,.2,1) .2s forwards}
@keyframes rise{to{transform:translateX(-50%) translateY(0)}}
.hero .wrap{position:relative;z-index:2}
.hgrid{display:grid;grid-template-columns:1.15fr 1fr;gap:2rem;align-items:end;width:100%}
.htext{padding-bottom:5rem}
.hphoto img{display:block;width:100%;max-width:440px;margin-left:auto;aspect-ratio:4/5;object-fit:cover;border-radius:220px 220px 0 0;border:6px solid #fff;border-bottom:0}
@media(max-width:760px){.hgrid{grid-template-columns:1fr}.hphoto img{max-width:340px;margin:0 auto}.htext{padding-bottom:2rem}}
.hero .btn{background:#0B0B10;color:#fff;border-color:#0B0B10}
.hero .btn.ghost{background:transparent;color:#0B0B10}
.hero :focus-visible{outline-color:#0B0B10}
.strip{background:#fff;color:#0B0B10;text-align:center;padding:1.2rem 1rem;font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:800;letter-spacing:.35em;font-size:clamp(.95rem,2.8vw,1.5rem)}
.strip small{display:block;font-weight:600;letter-spacing:.3em;font-size:.55em;margin-top:.3rem}
img.portrait{width:100%;object-fit:cover;background:#0B0B10}
.soc{display:flex;gap:.6rem;flex-wrap:wrap;margin-top:1.2rem}
.soc a{font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:600;font-size:.95rem;padding:.5rem 1rem;border:2px solid var(--line);border-radius:999px;text-decoration:none}
.soc a:hover{border-color:var(--sun);background:var(--sun);color:#0B0B10}
.talk:nth-child(3){border-color:#E0312F}
.hero h1{font-weight:800;font-size:clamp(3rem,10vw,7rem);max-width:11ch;color:#0B0B10}
.hero p{max-width:36rem;font-size:1.25rem;margin:1.4rem 0 2rem;color:#0B0B10;font-weight:500}
.btns{display:flex;gap:.8rem;flex-wrap:wrap}
.btn{display:inline-block;font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:800;font-size:1.05rem;padding:.9rem 1.5rem;border-radius:999px;text-decoration:none;border:2px solid var(--sun);background:var(--sun);color:var(--onsun);cursor:pointer}
.btn:hover{filter:brightness(1.07)}
.btn.ghost{background:rgba(20,18,46,.45);color:#fff;border-color:#fff}

section{padding:5rem 0}
h2{font-size:clamp(2rem,5vw,3.2rem);font-weight:800;margin-bottom:1rem}
.lead{max-width:40rem;color:var(--muted)}

.about{display:grid;grid-template-columns:1fr 1.4fr;gap:3rem;align-items:start}
.portrait{aspect-ratio:4/5;border-radius:22px 22px 120px 22px;background:linear-gradient(160deg,var(--indigo),#4B3F8F);display:grid;place-items:center;color:var(--sun);font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:800;font-size:7rem;position:sticky;top:2rem}
.tl{list-style:none;margin:1.8rem 0 0;padding:0 0 0 1.4rem;border-left:3px solid var(--sun)}
.tl li{margin-bottom:1.5rem;position:relative}
.tl li::before{content:"";position:absolute;left:calc(-1.4rem - 8px);top:.55rem;width:13px;height:13px;border-radius:50%;background:var(--sun)}
.tl b{font-family:"Bricolage Grotesque",Arial,sans-serif;font-size:1.15rem;display:block}
.tl span{color:var(--muted)}
@media(max-width:760px){.about{grid-template-columns:1fr}.portrait{max-width:300px;position:static}}

.talks{background:var(--indigo);color:#fff}
.talks h2{color:#fff}.talks .lead{color:#C9CAE6}
.talkgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:1.6rem;margin-top:2.5rem}
.talk{border-top:4px solid var(--sun);padding:1.2rem 0 0}
.talk:nth-child(2){border-color:#fff}
.talk h3{font-size:1.6rem;margin-bottom:.5rem}
.talk p{margin:0;color:#D6D7EE;font-size:1.05rem}

.ep{display:grid;grid-template-columns:1fr 1.2fr;gap:2.5rem;align-items:center;margin-top:2rem}
.thumb{aspect-ratio:16/9;border-radius:16px;background:linear-gradient(180deg,#0B0B10,#12354A 60%,#1EA3DE);display:grid;place-items:center;text-decoration:none;color:#fff;position:relative;overflow:hidden}
.thumb .play{width:72px;height:72px;border-radius:50%;background:var(--sun);color:var(--onsun);display:grid;place-items:center;font-size:1.5rem;padding-left:5px}
.thumb small{position:absolute;bottom:.8rem;left:1rem;font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:600}
.ep h3{font-size:1.8rem;margin-bottom:.6rem}
.meta{color:var(--muted);font-size:1rem;margin:0 0 1rem}
.topics{padding-left:1.2rem;margin:0 0 1.4rem;color:var(--muted)}
@media(max-width:760px){.ep{grid-template-columns:1fr}}

.quotes{background:var(--card);border-block:1px solid var(--line)}
.qgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:2.5rem;margin-top:2rem}
blockquote{margin:0;font-size:1.35rem;line-height:1.45;border-left:4px solid var(--sun);padding-left:1.1rem}
blockquote footer{margin-top:.8rem;font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:600;font-size:.95rem;color:var(--muted)}

.cause{background:linear-gradient(135deg,#0B0B10,#12354A);color:#fff}
.cause .wrap{display:grid;grid-template-columns:1.4fr 1fr;gap:3rem;align-items:center}
.cause h2{color:#fff}.cause p{color:#D6D7EE;max-width:36rem}
.goal{border:2px solid var(--sun);border-radius:20px;padding:1.8rem;text-align:center}
.goal b{display:block;font-family:"Bricolage Grotesque",Arial,sans-serif;font-size:3.2rem;color:var(--sun);line-height:1}
.goal span{display:block;margin:.5rem 0 1.2rem;color:#D6D7EE;font-size:1rem}
@media(max-width:760px){.cause .wrap{grid-template-columns:1fr}}

.contact{display:grid;grid-template-columns:1fr 1.2fr;gap:3rem}
@media(max-width:760px){.contact{grid-template-columns:1fr}}
label{display:block;font-family:"Bricolage Grotesque",Arial,sans-serif;font-weight:600;font-size:.95rem;margin:1rem 0 .3rem}
input,select,textarea{width:100%;font:inherit;font-size:1.05rem;padding:.75rem .9rem;border:2px solid var(--line);border-radius:10px;background:var(--card);color:var(--fg)}
textarea{min-height:120px;resize:vertical}
#msg{margin-top:1rem;color:var(--muted);font-size:1rem}
footer.site{padding:2.5rem 0;color:var(--muted);font-size:1rem;border-top:1px solid var(--line)}
footer.site .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem}
@media (prefers-reduced-motion:reduce){.sun{animation:none;transform:translateX(-50%) translateY(0)}html{scroll-behavior:auto}}
